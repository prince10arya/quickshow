  "name": "",
  "email": "not-an-email",
  "password": "123"
}

### 7.3 Validation Error Test: Invalid Mongo ID in Booking Seats Param
GET {{baseUrl}}/api/bookings/seats/invalid-mongo-id-123

### 7.4 Route Not Found Error Test (Should return 404 AppError JSON)
GET {{baseUrl}}/api/non-existent-route-xyz

###############################################################################
# 8. MCP TOOLS SERVICE (PORT 3002) - MCP SSE, TOOLS & ERROR HANDLING
###############################################################################

### 8.1 MCP Service Health Check
GET {{mcpBaseUrl}}/health

### 8.2 Establish SSE Transport Connection
# Note: In REST Client, this opens the SSE stream and yields the endpoint event with active sessionId
GET {{mcpBaseUrl}}/sse
Accept: text/event-stream

### 8.3 List All Registered Tools (JSON-RPC 2.0)
POST {{mcpBaseUrl}}/messages?sessionId={{mcpSessionId}}
Content-Type: {{contentType}}

{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "tools/list",
  "params": {}
}

### 8.4 Call Tool: list_all_movies
POST {{mcpBaseUrl}}/messages?sessionId={{mcpSessionId}}
Content-Type: {{contentType}}

{
  "jsonrpc": "2.0",
  "id": 2,
  "method": "tools/call",
  "params": {
    "name": "list_all_movies",
    "arguments": {}
  }
}

### 8.5 Call Tool: list_movies_by_genre
POST {{mcpBaseUrl}}/messages?sessionId={{mcpSessionId}}
Content-Type: {{contentType}}

{
  "jsonrpc": "2.0",
  "id": 3,
  "method": "tools/call",
  "params": {
    "name": "list_movies_by_genre",
    "arguments": {
      "genre": "Sci-Fi"
    }
  }
}

### 8.6 Call Tool: get_movie_details (by Title)
POST {{mcpBaseUrl}}/messages?sessionId={{mcpSessionId}}
Content-Type: {{contentType}}

{
  "jsonrpc": "2.0",
  "id": 4,
  "method": "tools/call",
  "params": {
    "name": "get_movie_details",
    "arguments": {
      "title": "Interstellar"
    }
  }
}

### 8.7 Call Tool: search_upcoming_shows
POST {{mcpBaseUrl}}/messages?sessionId={{mcpSessionId}}
Content-Type: {{contentType}}

{
  "jsonrpc": "2.0",
  "id": 5,
  "method": "tools/call",
  "params": {
    "name": "search_upcoming_shows",
    "arguments": {
      "query": "Interstellar"
    }
  }
}

